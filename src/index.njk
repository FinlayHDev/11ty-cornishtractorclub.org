<!-- about -->
<section class="section">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 mx-auto text-center">
        <h2 id="about" class="section-title mb-3">{{ siteSettings.aboutTitle }}</h2>
        {{ siteSettings.aboutIntro | safe }}
        <div class="section-border"></div>
      </div>
    </div>
    <div class="row">
      {% for activity in clubActivities %}
      <div class="col-lg-4 mb-4 mb-lg-0">
        <div class="card hover-bg-secondary shadow py-4">
          <div class="card-body text-center">
            {% if activity.icon %}
            <div class="position-relative">
              <i class="icon-lg icon-box bg-gradient-primary rounded-circle {{ activity.icon }} mb-5 d-inline-block text-white"></i>
              <i class="icon-lg icon-watermark text-white {{ activity.icon }}"></i>
            </div>
            {% endif %}
            <h4 class="mb-4">{{ activity.title }}</h4>
            {{ activity.body | safe }}
            {% if activity.hasLink %}
            <a href="{{ activity.linkUrl }}" target="_blank" rel="noopener noreferrer" class="d-inline-block pt-4">{{ activity.linkLabel }}</a>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="text-center pt-5">
      <h4>We are supporting</h4>
      {% if charity.logo %}<a href="{{ charity.url }}" target="_blank" rel="noopener noreferrer"><img class="pt-2 img-fluid" src="{{ charity.logo }}" alt="{{ charity.name }}"></a>{% elif charity.name %}<a href="{{ charity.url }}" target="_blank" rel="noopener noreferrer">{{ charity.name }}</a>{% endif %}
    </div>
  </div>
</section>
<!-- /about -->

