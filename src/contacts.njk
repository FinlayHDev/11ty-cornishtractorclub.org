<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="utf-8">
  <title>Contacts | Cornish Tractor Club</title>

  <!-- mobile responsive meta -->
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- metadata -->
  <meta name="theme-name" content="CTC" />
  <meta name="description" content="Welcome to the Cornish Tractor Club! - We are a tractor club based in Cornwall, organising events throughout the year for our members.">
  <meta name="theme-color" content="#04560e">

  <!-- ** Plugins Needed for the Project ** -->
  <!-- Bootstrap -->
  <link rel="stylesheet" href="../plugins/bootstrap/bootstrap.min.css">
  <!-- slick slider -->
  <link rel="stylesheet" href="../plugins/slick/slick.css">
  <!-- themefy-icon -->
  <link rel="stylesheet" href="../plugins/themify-icons/themify-icons.css">
  <!-- venobox css -->
  <link rel="stylesheet" href="../plugins/venobox/venobox.css">
  <!-- card slider -->
  <link rel="stylesheet" href="../plugins/card-slider/css/style.css">
  <!-- font awesome -->
  <script src="https://kit.fontawesome.com/73cb94768c.js" crossorigin="anonymous"></script>

  <!-- Main Stylesheet -->
  <link href="../css/style.css" rel="stylesheet">

  <!--Favicon-->
  <link rel="shortcut icon" href="../images/cornish-tractor-club.png" type="image/x-icon">
  <link rel="icon" href="../images/cornish-tractor-club.png" type="image/x-icon">

</head>

<body>


  <header class="navigation fixed-top bg-transparent">
    <nav class="navbar navbar-expand-lg navbar-dark">
      <a class="navbar-brand" href="../index"><img src="../images/cornish-tractor-club.png" alt="CTC-Logo" height="80"></a>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation"
        aria-controls="navigation" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse text-center" id="navigation">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item">
            <a class="nav-link" href="../index">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="../index#about">About</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="../events">Events</a>
          <li class="nav-item">
            <a class="nav-link" href="../blog">Blog</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="../gallery">Gallery</a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Forms</a>
            <div class="dropdown-menu dropdown-menu-external">
              <a class="dropdown-item" href="{{ rallyforms.exhibitor }}">Rally - Exhibitor</a>
              <a class="dropdown-item" href="{{ rallyforms.craft }}">Rally - Craft</a>
              <a class="dropdown-item" href="{{ rallyforms.trade }}">Rally - Trade</a>
              <a class="dropdown-item" href="{{ rallyforms.model }}">Rally - Model</a>
              <a class="dropdown-item" href="{{ rallyforms.termsandconditions }}">Rally - T&Cs</a>
              <a class="dropdown-item" href="/membership">Membership Form</a>


            </div>
          </li>
          <li class="nav-item active">
            <a class="nav-link" href="../contacts">Contacts</a>
          </li>
        </ul>
      </div>
    </nav>
  </header>

<!-- page-title -->
<section class="page-title bg-cover background-overlay" data-background="../images/backgrounds/contacts.jpg">
  <div class="container">
    <div class="row">
      <div class="col-12 text-center">
        <h1 class="display-1 text-white font-weight-bold font-primary">Contacts</h1>
      </div>
    </div>
  </div>
</section>
<!-- /page-title -->

<!-- officials -->
<section class="section bg-light pb-0">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 mx-auto text-center">
        <h2>Club Officials</h2>
        <div class="section-border"></div>
      </div>
    </div>
    <div class="row no-gutters align-items-end">
      {% for official in clubOfficials %}
      <div class="col-lg-3 col-sm-6">
        <div class="card hover-shadow">
          {% if official.photo %}
          <img src="{{ official.photo }}" alt="{{ official.name or official.role }}" class="card-img-top">
          {% endif %}
          <div class="card-body text-center position-relative zindex-1">
            <h4><a class="text-dark">{{ official.role }}</a></h4>
            {% if official.name %}<i>{{ official.name }}<br><br></i>{% endif %}
            {% if official.phone %}<a class="tel1" href="tel:{{ official.tel }}">{{ official.phone }}</a>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
<!-- /officials -->

<!-- secretaries and committee -->
<section class="section bg-light">
  <div class="col-lg-10 mx-auto text-center">
  <h2>Section Secretaries and Committee</h2>
  <div class="section-border section-padding1 "></div>
  <div class="container">
    <div class="row">
      {% for member in committeeMembers %}
      <div class="col-12 bg-white p-4 mb-3">
        <div class="media align-items-center flex-column flex-sm-row">
          <div class="media-body text-center text-sm-left mb-4 mb-sm-0">
            <h4 class="text-secondary">{{ member.role }}</h4>
            {% if member.name %}<p class="mb-0">{{ member.name }}</p>{% endif %}
          </div>
          {% if member.hasPhone %}
          <a href="tel:{{ member.tel }}" class="btn btn-outline-primary">{{ member.phone }}</a>
          {% elif member.hasEmail %}
          <a href="mailto:{{ member.email }}" class="btn btn-outline-primary">Email</a>
          {% else %}
          <span class="btn btn-outline-primary disabled" aria-disabled="true">N/A</span>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
<!-- /secretaries and committee -->

<!-- footer -->
<footer class="bg-secondary position-relative">
  <div class="section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-3 col-6">
          <h4 class="text-white mb-5">Quick Links</h4>
          <ul class="list-unstyled">
            <li><a href="../index" class="text-light d-block mb-3">Home</a></li>
            <li><a href="../#about" class="text-light d-block mb-3">About</a></li>
            <li><a href="../events" class="text-light d-block mb-3">Events</a></li>
            <li><a href="../contacts" class="text-light d-block mb-3">Contacts</a></li>
          </ul>
        </div>
        <div class="col-md-3 col-6">
          <h4 class="text-white mb-5">Other</h4>
          <ul class="list-unstyled">
            <li><a href="../terms" class="text-light d-block mb-3">Terms and Conditions</a></li>
            <li><a href="../privacy" class="text-light d-block mb-3">Privacy Policy</a></li>
            <li><a href="../faqs" class="text-light d-block mb-3">FAQs</a></li>
          </ul>
        </div>
        <div class="col-md-6 facebook-widget">
          <div class="facebook-widget-border">
            <div class="fb-page" data-href="https://www.facebook.com/officialcornishtractorclub" data-tabs="timeline" data-width="" data-height="" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true"><blockquote cite="https://www.facebook.com/officialcornishtractorclub" class="fb-xfbml-parse-ignore"><a href="https://www.facebook.com/officialcornishtractorclub">Cornish Tractor Club</a></blockquote></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="pb-4">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6 text-center text-md-left">
          <p class="text-light mb-0">Copyright &copy; Cornish Tractor Club <span id="currentYear"></span></a>
          </p>
        </div>
        <div class="col-md-6">
          <ul class="list-inline text-md-right text-center">
            <li class="list-inline-item"><a class="d-block p-3 text-white" href="https://www.facebook.com/officialcornishtractorclub" target="_blank" rel="noopener noreferrer"><i class="ti-facebook"></i></a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
<!-- /footer -->

<!-- jQuery -->
<script src="../plugins/jQuery/jquery.min.js"></script>
<!-- Bootstrap JS -->
<script src="../plugins/bootstrap/bootstrap.min.js"></script>
<!-- slick slider -->
<script src="../plugins/slick/slick.min.js"></script>
<!-- venobox -->
<script src="../plugins/venobox/venobox.min.js"></script>
<!-- shuffle -->
<script src="../plugins/shuffle/shuffle.min.js"></script>
<!-- apear js -->
<script src="../plugins/counto/apear.js"></script>
<!-- counter -->
<script src="../plugins/counto/counTo.js"></script>
<!-- card slider -->
<script src="../plugins/card-slider/js/card-slider-min.js"></script>
<!-- google map -->
<script src=""></script>
<script src="../plugins/google-map/gmap.js"></script>
<!-- facebook page -->
<div id="fb-root"></div>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_GB/sdk.js#xfbml=1&version=v16.0&appId=1486495898423162&autoLogAppEvents=1" nonce="VbdW31Vb"></script>
<!-- Cloudflare Web Analytics -->
<script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "1609afda063e4bc18473fdce079932b5"}'></script>

<!-- Main Script -->
<script src="../js/script.js"></script>

</body>
</html>
